# Copy to .env. Everything is optional until you connect Azure.

# Database (docker compose sets MF_DATABASE_URL for the api container itself)
MF_DB_PASSWORD=mf
MF_DATABASE_URL=postgresql+psycopg://mf:mf@localhost:5432/mf
MF_TIMEZONE=Asia/Kolkata

# Signs session cookies. Generated into media/.secret_key if left empty.
MF_SECRET_KEY=
# Set to true when serving over HTTPS (e.g. phone access through Caddy)
MF_COOKIE_SECURE=false

# fake | azure per capability. "fake" never calls a paid service.
MF_GRADER_PROVIDER=fake
MF_NOTES_PROVIDER=fake
MF_GLOSSARY_PROVIDER=fake
MF_EMBEDDING_PROVIDER=fake
MF_SPEECH_PROVIDER=fake
MF_REALTIME_PROVIDER=fake
MF_AZURE_OPENAI_ENDPOINT=
MF_AZURE_OPENAI_API_KEY=
MF_AZURE_OPENAI_TEXT_DEPLOYMENT=gpt-5.4-mini
MF_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
MF_AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1-mini
MF_AZURE_SPEECH_KEY=
MF_AZURE_SPEECH_REGION=

# Default monthly caps (USD) until you set them on the budget screen
MF_DEFAULT_CAP_OPENAI_USD=5
MF_DEFAULT_CAP_SPEECH_USD=2
MF_DEFAULT_CAP_TOTAL_USD=6

# Set to http://obs:4318 (compose) or http://localhost:4318 to send traces to Grafana
MF_OTEL_ENDPOINT=
